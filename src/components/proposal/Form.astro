---

---

<div
  class="relative border border-navy/15 bg-paper-raised p-6 sm:p-10 shadow-[6px_6px_0_0_rgba(20,33,61,0.9)]"
>
  <span class="eyebrow absolute -top-3 left-6 bg-paper px-2 text-xs">
    AcademicHUB
  </span>
  <h2
    class="font-body text-2xl text-center sm:text-4xl font-semibold text-navy"
  >
    Formulario
  </h2>

  <form id="propuesta-form" class="mt-8 flex flex-col gap-6" novalidate>
    <div class="flex flex-col gap-1.5">
      <label for="titulo" class="eyebrow font-normal">Título</label>
      <input
        id="titulo"
        name="titulo"
        type="text"
        required
        maxlength="120"
        placeholder="Ej. Introducción a Terraform"
        class="border border-navy/25 bg-paper px-4 py-3 font-mono text-sm text-navy placeholder:text-navy/35 focus:border-orange transition-colors"
      />
    </div>

    <div class="flex flex-col gap-1.5">
      <label for="tema" class="eyebrow font-normal">¿De qué trataría?</label>
      <textarea
        id="tema"
        name="tema"
        required
        rows="4"
        maxlength="600"
        placeholder="Describe brevemente qué se vería en la sesión, nivel del público, duración estimada…"
        class="border border-navy/25 bg-paper px-4 py-3 font-mono text-sm text-navy placeholder:text-navy/35 focus:border-orange transition-colors resize-y"
      ></textarea>
    </div>

    <div class="flex flex-col gap-1.5">
      <label for="area" class="eyebrow font-normal">Área relacionada</label>
      <select
        id="area"
        name="area"
        class="border border-navy/25 bg-paper px-4 py-3 font-mono text-sm text-navy focus:border-orange transition-colors"
      >
        <option value="">— Elegir área —</option>
        <option value="Diseño UX/UI">Diseño UX/UI</option>
        <option value="Inteligencia Artificial">Inteligencia Artificial</option>
        <option value="Machine Learning">Machine Learning</option>
        <option value="Desarrollo Web">Desarrollo Web</option>
        <option value="Ciencia de Datos">Ciencia de Datos</option>
        <option value="Computación en la Nube">Computación en la Nube</option>
        <option value="DevOps">DevOps</option>
        <option value="Desarrollo de Software">Desarrollo de Software</option>
        <option value="Herramientas NO-CODE/Low-CODE"
          >Herramientas NO-CODE/Low-CODE</option
        >
      </select>
    </div>

    <div class="flex flex-col gap-1.5">
      <label for="plataforma" class="eyebrow font-normal">Plataforma</label>
      <select
        id="plataforma"
        name="plataforma"
        class="border border-navy/25 bg-paper px-4 py-3 font-mono text-sm text-navy focus:border-orange transition-colors"
      >
        <option value="">— Elegir plataforma —</option>
        <option value="Google Meet">Google Meet</option>
        <option value="Microsoft Teams">Microsoft Teams</option>
      </select>
    </div>

    <input
      name="website"
      class="hidden"
      tabindex="-1"
      autocomplete="off"
      aria-hidden="true"
    />

    <p id="form-msg" class="hidden font-mono text-sm" role="status"></p>

    <button
      type="submit"
      class="mx-auto mt-2 w-full sm:w-auto bg-orange text-paper px-8 py-3 font-body text-sm uppercase tracking-wide hover:bg-navy transition-colors"
    >
      Enviar propuesta
    </button>
  </form>
</div>
