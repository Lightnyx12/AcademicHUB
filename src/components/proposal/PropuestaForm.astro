---
import Form from "../proposal/Form.astro";
import SectionHeading from "../SectionHeading.astro"
--- 

<section class="mx-auto max-w-7xl px-5 sm:px-8 py-16 scroll-mt-20">
  <div class="grid md:grid-cols-12 gap-10">
    <div class="md:col-span-4">
      <SectionHeading  
       eyebrow="Nueva propuesta"
        title="Propón el próximo webinar"
        description="Contanos qué te gustaría aprender. Tu idea será revisado por nuestro equipo "
      />
    </div>
    <div class="md:col-span-8 rounded-sm border border-navy/12 bg-paper-raised p-6 sm:p-8">
      <Form 
      id="propuesta-form"/>
    </div>
  </div>
</section>

  


<script>
  import { supabase } from "../../lib/supabase";

  const form = document.getElementById("propuesta-form") as HTMLFormElement;
  const msg = document.getElementById("form-msg") as HTMLParagraphElement;

  function show(message: string, ok: boolean) {
    msg.textContent = message;
    msg.classList.remove("hidden");
    msg.classList.toggle("text-green", ok);
    msg.classList.toggle("text-orange", !ok);
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const data = new FormData(form);

    if ((data.get("website") as string)?.length) return;

    const { error } = await supabase.from("propuestas").insert({
      titulo: data.get("titulo") as string,
      tema: data.get("tema") as string,
      plataforma: (data.get("plataforma") as string) || null,
    });

    if (error) {
      show("No se pudo enviar. Inténtalo de nuevo.", false);
      return;
    }

    show("¡Propuesta enviada! Gracias por participar.", true);
    form.reset();
  });
</script>