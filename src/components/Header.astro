---
const links = [
  { name: "Inicio", href: "#inicio" },
  { name: "Crear Propuesta", href: "#crear-propuesta" },
  { name: "Temas", href: "#temas" },
];
---

<header
  class="sticky top-0 z-40 border-b border-navy/10 bg-paper/90 backdrop-blur"
>
  <div
    class="relative mx-auto flex max-w-7xl items-center justify-between px-3 sm:px-8 py-4"
  >
    <a href="#inicio" class="flex items-center gap-1 group">
      <img src="/images/AcademicHUB.png" alt="Academic Hub" class="w-8 h-8" />
      <span class="font-heading font-semibold text-navy tracking-tight"
        >Academic Hub</span
      >
    </a>
    <nav
      class="absolute left-1/2 -translate-x-1/2 hidden md:flex items-center gap-8"
      aria-label="Navegación principal"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            class="font-heading text-[0.85rem] font-semibold uppercase tracking-tight text-navy/70 hover:text-orange transition-colors"
          >
            {link.name}
          </a>
        ))
      }
    </nav>
  </div>

  <button
    id="mobile-menu-toggle"
    type="button"
    class="md:hidden flex flex-col gap-1.5 p-2"
    aria-expanded="false"
    aria-controls="mobile-menu"
    aria-label="Abrir menú"
  >
    <span class="block h-[1.5px] w-6 bg-navy"></span>
    <span class="block h-[1.5px] w-6 bg-navy"></span>
    <span class="block h-[1.5px] w-4 bg-navy"></span>
  </button>
</header>

<nav
  id="mobile-menu"
  class="md:hidden hidden border-t border-navy/10 bg-paper px-5 py-4 flex flex-col gap-4"
  aria-label="Navegación móvil"
>
  {
    links.map((link) => (
      <a
        href={link.href}
        class="font-mono text-sm uppercase tracking-wide text-navy/80"
      >
        {link.name}
      </a>
    ))
  }
  <a
    href="#crear-propuesta"
    class="font-mono text-sm uppercase tracking-wide bg-navy text-paper px-4 py-2 rounded-sm text-center"
  >
    Proponer un tema
  </a>
</nav>
