<section
  id="inicio"
  class="mx-auto flex min-h-screen flex-col items-center justify-center px-4 sm:px-8"
>
  <div class="flex flex-col items-center text-center">
    <h1
      class="max-w-7xl font-body text-5xl sm:text-5xl lg:text-[3.4rem] font-semibold text-navy"
    >
      Tu Idea definirá la proxima sesion!
    </h1>

    <div class="mt-8 flex flex-wrap justify-center items-center gap-4">
      <a
        href="#crear-propuesta"
        class="font-body text-sm uppercase tracking-wide bg-orange text-paper px-5 py-3 rounded-sm hover:bg-navy transition-colors"
      >
        Proponer un tema
      </a>
    </div>

    <dl class="mt-12 flex flex-wrap justify-center gap-x-10 gap-y-4">
      <div>
        <dt class="eyebrow">Propuestas activas</dt>
        <dd class="font-heading text-2xl text-navy mt-1">8</dd>
      </div>

      <div>
        <dt class="eyebrow">Plataformas</dt>
        <dd class="font-heading text-2xl text-navy mt-1">Meet · Teams</dd>
      </div>
    </dl>
  </div>
</section>
