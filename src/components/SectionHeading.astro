---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  class?: string;
}

const { eyebrow, title, description, align = "left", class: className = "" } = Astro.props;
---

<div class:list={["max-w-2xl", align === "center" && "mx-auto text-center", className]}>
  <p class="eyebrow mb-3">{eyebrow}</p>
  <h2 class="font-heading text-3xl sm:text-4xl font-semibold text-navy leading-[1.1]">
    {title}
  </h2>
  {description && <p class="mt-3 text-ink-soft text-base sm:text-lg leading-relaxed">{description}</p>}
</div>